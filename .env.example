# Bot token from @BotFather (required)
BOT_TOKEN=

# Database (required) — PostgreSQL connection string.
# No SQLite is used anymore; without this the bot cannot run.
DATABASE_URL=postgresql://user:password@host:5432/database

# Your Telegram username (no @) — used as the owner
OWNER_USERNAME=

# Optional: support channel (no @)
SUPPORT_CHANNEL=

# Optional: protect the dashboard with a password (leave empty = open access)
ADMIN_PASSWORD=

# Optional: public URL for "View on Website" leaderboard buttons
PUBLIC_URL=

# Optional: Chat Activity master switch + timezone
CHAT_ACTIVITY_ENABLED=1
CHAT_ACTIVITY_TIMEZONE=Asia/Dhaka

# Optional: ranking anti-spam
RANK_SPAM_MAX=4
RANK_SPAM_WINDOW=4.0
RANK_SPAM_COOLDOWN=600

# ─── Dashboard (/start) ───
# Bot display name (used in the welcome card, About page, title)
BOT_NAME=MISS WAGURI
# Bot version — omit to leave the version line hidden (nothing is fabricated)
BOT_VERSION=
# Bot @username used for the "Add to Group" deep link (leave empty to use the live Telegram username)
BOT_USERNAME=
# Welcome media sent with the dashboard (photo/video/animation). Leave empty for a plain text dashboard.
WELCOME_MEDIA=
WELCOME_MEDIA_TYPE=photo
# Developer page (optional — hidden when unconfigured)
DEVELOPER_NAME=
DEVELOPER_USERNAME=
DEVELOPER_URL=
# Support contact / channel (optional)
SUPPORT_URL=
UPDATE_CHANNEL_URL=
# GitHub repository link (optional)
GITHUB_URL=
# Other projects (optional, free text)
OTHER_PROJECTS=
# Release notes for the Updates page (optional, multi-line — never fabricated)
UPDATE_CHANGELOG=
